# ---- Application ----
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- Backends: "real" uses Neo4j/pgvector; "memory" uses in-process fakes (tests/offline) ----
GRAPH_BACKEND=memory
VECTOR_BACKEND=memory

# ---- Neo4j (GRAPH_BACKEND=real) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ---- Postgres + pgvector (VECTOR_BACKEND=real) ----
DATABASE_URL=postgresql://krag:krag@localhost:5432/krag

# ---- Embeddings ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- LLM provider (OpenAI-compatible). Leave blank to use the deterministic stub. ----
# Example: base_url=https://api.openai.com/v1 api_key=$OPENAI_API_KEY model=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# ---- Retrieval / QA ----
QA_TOP_K_VECTOR=8
QA_TOP_K_GRAPH=12
QA_MAX_HOPS=3
ROUTER_LOW_CONFIDENCE_THRESHOLD=0.55
